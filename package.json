{
  "name": "@uplinkxyz/erlc",
  "version": "0.2.1",
  "type": "module",
  "description": "TypeScript client for the ER:LC Private Server API",
  "license": "MIT",
  "author": "uplinkxyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uplinkxyz/erlc.git"
  },
  "homepage": "https://github.com/uplinkxyz/erlc#readme",
  "bugs": "https://github.com/uplinkxyz/erlc/issues",
  "keywords": ["erlc", "roblox", "liberty-county", "emergency-response", "api-client"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "lint": "eslint --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "tsup": "^8.5.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}